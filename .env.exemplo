# =============================================================================
# Variaveis de ambiente do projeto UBS. Copie para ".env" e ajuste.
#
# PADRAO DE NOMES
#   - Variaveis do backend = nome da propriedade Spring em MAIUSCULAS, com "."
#     e "-" trocados por "_"  (security.jwt.secret-key -> SECURITY_JWT_SECRET_KEY).
#   - Variaveis do container MySQL = nomes oficiais da imagem (MYSQL_*).
#   - Caminhos publicos = <PARTE>_BASE_PATH.
#   Cada valor tem UM nome so: o mesmo aqui, no compose.yaml e no codigo.
# =============================================================================

# ---- Banco de dados (container mysql_server) --------------------------------
MYSQL_ROOT_PASSWORD=12345678
MYSQL_DATABASE=ubs

# ---- Backend: conexao com o banco -------------------------------------------
# O host e o nome do servico no compose.yaml (mysql_server).
SPRING_DATASOURCE_URL=jdbc:mysql://mysql_server:3306/ubs
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=12345678
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_GENERATE_DDL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=ubs
SPRING_JPA_SHOW_SQL=true

# ---- Backend: servidor e seguranca -------------------------------------------
SERVER_PORT=8080
SPRING_SECURITY_ENABLED=true
# Chave HMAC do JWT: no minimo 32 caracteres (256 bits).
SECURITY_JWT_SECRET_KEY="Crie uma chave de seguranca para o JWT aqui com 32+ caracteres"
# Validade do token em milissegundos (3600000 = 1h).
SECURITY_JWT_EXPIRATION_TIME=3600000
# Origens do navegador liberadas no CORS, separadas por virgula
# (parametro interno do projeto; vira a propriedade lista.hosts).
# O app mobile nao precisa estar aqui: CORS so vale para navegador.
LISTA_HOSTS=http://localhost:4200,https://localhost:4200,http://localhost:8081

# ---- Caminhos publicos (nginx-ubs e backend) ---------------------------------
# Obrigatorios e nao vazios: comecam com "/" e nao terminam com "/".
# Ver nginx-ubs/README.md.
# Prefixo do app Angular servido pelo nginx-ubs.
FRONT_BASE_PATH=/outro-diretorio
# Prefixo da API. Tambem e o que se informa no app mobile:
#   http://<servidor>:8081/diretorio-api
API_BASE_PATH=/diretorio-api
