# ==========================================================================
# Modelo de variaveis de ambiente para o Docker Compose.
# Copie para um arquivo chamado ".env" e ajuste os valores:
#   cp .env.example .env
# ==========================================================================

# ---------- Banco de dados (MySQL) ----------
DB_ROOT_PASSWORD=12345678
DB_NAME=ubs
DB_USER=root
DB_PASSWORD=12345678
DB_HOST=mysql_server
DB_PORT=3306
DB_SCHEMA=ubs

# ---------- Servidor / Seguranca ----------
SERVER_PORT=8080
SECURITY_JWT_SECRET_KEY=7a8b3c9d1e2f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4
SECURITY_JWT_EXPIRATION_TIME=3600000
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ---------- CORS ----------
LISTA_HOSTS=http://localhost:4200
