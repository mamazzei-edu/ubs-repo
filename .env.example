# =============================================================================
# Modelo de configuracao do projeto UBS.
#
# COPIE este arquivo para ".env" na mesma pasta e substitua os valores
# marcados com ALTERAR. O arquivo ".env" nao vai para o repositorio.
#
#     Linux/macOS:  cp .env.example .env
#     Windows:      copy .env.example .env
#
# Depois de alterar apenas FRONT_BASE_PATH ou API_BASE_PATH, basta
# "docker compose up -d" — nao e preciso reconstruir imagem nem recompilar.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
DB_HOST=mysql_server
DB_PORT=3306
DB_NAME=ubs
DB_SCHEMA=ubs

# ATENCAO: nao pode ser "root" — a imagem oficial do MySQL recusa subir.
DB_USER=ubs_app
DB_PASSWORD=ALTERAR_senha_do_usuario
DB_ROOT_PASSWORD=ALTERAR_senha_do_root
MYSQL_ROOT_PASSWORD=ALTERAR_senha_do_root

# -----------------------------------------------------------------------------
# Conexao do backend com o banco
# -----------------------------------------------------------------------------
# mysql_server:3306 e o endereco INTERNO da rede do Docker. Nao trocar para
# localhost nem para a porta publicada no compose.yaml.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql_server:3306/ubs
SPRING_DATASOURCE_USERNAME=root
# Precisa ser igual a DB_ROOT_PASSWORD acima.
SPRING_DATASOURCE_PASSWORD=ALTERAR_senha_do_root
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# "update" cria e ajusta as tabelas na partida. Com o esquema estavel,
# "validate" e mais seguro: confere sem alterar.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_GENERATE_DDL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=ubs

# true faz o Hibernate imprimir todo o SQL no log. Esta variavel tem
# precedencia sobre o application.properties.
SPRING_JPA_SHOW_SQL=false

# -----------------------------------------------------------------------------
# Aplicacao e seguranca
# -----------------------------------------------------------------------------
SPRING_APPLICATION_NAME=UBS
SERVER_PORT=8080
SPRING_SECURITY_ENABLED=true

# No MINIMO 64 caracteres aleatorios: chave curta derruba o backend na partida.
#   Linux/macOS:  openssl rand -base64 64 | tr -d '\n='
SECURITY_JWT_SECRET_KEY=ALTERAR_chave_com_no_minimo_64_caracteres_aleatorios_aqui_ok

# Validade do token, em milissegundos (3600000 = 1 hora).
SECURITY_JWT_EXPIRATION_TIME=3600000

# Origens aceitas pelo CORS. Incluir todos os enderecos de onde a aplicacao
# sera aberta, separados por virgula e sem espacos.
LISTA_HOSTS=http://localhost:4200,https://localhost:4200,http://localhost:8081

# -----------------------------------------------------------------------------
# Caminhos publicos
# -----------------------------------------------------------------------------
# Lidos na PARTIDA dos conteineres. Comecam com "/" e nao terminam com "/".
# A aplicacao responde em http://localhost:8081<FRONT_BASE_PATH>/
#
# Ao alterar aqui, alterar junto (necessario apenas para o "ng serve"):
#   frontend/angular.json      -> baseHref e servePath, COM barra no final
#   frontend/proxy.conf.json   -> a chave, SEM barra no final
FRONT_BASE_PATH=/ubs
API_BASE_PATH=/ubs-api
