# =============================================================================
# Template processado na PARTIDA do container pelo entrypoint da imagem nginx
# (/docker-entrypoint.d/20-envsubst-on-templates.sh), que roda envsubst sobre
# /etc/nginx/templates/*.template e grava em /etc/nginx/conf.d/.
#
# Variaveis vindas do .env via compose.yaml:
#   ${FRONT_BASE_PATH}  caminho publico do app Angular   (ex.: /outro-diretorio)
#   ${API_BASE_PATH}    caminho publico da API           (ex.: /diretorio-api)
#
# Trocar qualquer um dos dois e um "docker compose up -d" — sem rebuild.
#
# ATENCAO: o envsubst so substitui nomes entre chaves e restritos pelo filtro
# NGINX_ENVSUBST_FILTER (ver compose.yaml). As variaveis do proprio nginx sao
# escritas como $nome, sem chaves, e por isso passam intactas.
# =============================================================================

# Cache longo so para os arquivos com hash no nome; o index.html nunca.
map $uri $ubs_expires {
    default                                                    off;
    ~*\.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg|map)$    1y;
}

# Preserva o X-Forwarded-Proto de um proxy reverso a frente. Sobrescrever com
# $scheme faria o backend enxergar "http" quando o TLS termina la fora, e todo
# redirect do Spring sairia com esquema errado.
map $http_x_forwarded_proto $ubs_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_x_forwarded_host $ubs_host {
    default $http_x_forwarded_host;
    ""      $host;
}

server {
    listen       8081;
    server_name  localhost;

    root /usr/share/nginx/html;
    index index.html;

    access_log off;
    error_log  /dev/stderr warn;

    # Upload de fichas. Um proxy reverso a frente precisa de valor igual ou
    # maior, senao ele barra o upload antes de chegar aqui.
    client_max_body_size 20m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # DNS interno do Compose. Necessario porque o endereco do backend e usado
    # atraves de variavel: com nome literal o nginx resolveria "backend" ao
    # carregar a configuracao e se recusaria a subir enquanto o backend
    # estivesse fora do ar, derrubando o frontend junto.
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $ubs_backend "backend:8080";

    # A raiz do servidor leva ao app.
    location = / {
        return 302 ${FRONT_BASE_PATH}/;
    }

    # Sem a barra final o navegador resolveria o <base href> errado.
    location = ${FRONT_BASE_PATH} {
        return 301 ${FRONT_BASE_PATH}/;
    }

    # -------------------------------------------------------------------------
    # API. O backend roda sob o MESMO prefixo (server.servlet.context-path),
    # entao a URI e repassada inalterada — sem rewrite, sem barra final no
    # proxy_pass. Mesma origem do frontend: sem CORS e com o cookie JWT valido.
    #
    # O "^~" garante prioridade sobre qualquer location regex.
    # -------------------------------------------------------------------------
    location ^~ ${API_BASE_PATH}/ {
        proxy_pass         http://$ubs_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $ubs_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $ubs_proto;
        proxy_set_header   X-Forwarded-Host  $ubs_host;
    }

    # -------------------------------------------------------------------------
    # App Angular. Os arquivos ficam na RAIZ de /usr/share/nginx/html; o prefixo
    # publico e removido pelo rewrite. Isso deixa o caminho configuravel em
    # runtime sem mover arquivo nenhum, e evita "alias", que combinado com
    # try_files perde o caminho no fallback e devolve 404 no refresh de rota.
    # -------------------------------------------------------------------------
    location ${FRONT_BASE_PATH}/ {
        rewrite ^${FRONT_BASE_PATH}/(.*)$ /$1 break;

        expires $ubs_expires;
        try_files $uri $uri/index.html /index.html;
    }
}
