<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE: somente HTTPS. O app trafega senha, token JWT e dados de pacientes;
  em http:// tudo isso passa aberto pela rede Wi-Fi da unidade.

  Se for INDISPENSAVEL usar http numa rede interna, libere apenas o servidor
  da UBS (nunca o base-config inteiro), por exemplo:

      <domain-config cleartextTrafficPermitted="true">
          <domain includeSubdomains="false">192.168.0.10</domain>
      </domain-config>

  O build de debug usa src/debug/res/xml/network_security_config.xml, que
  libera http para testes no emulador e na rede local.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
